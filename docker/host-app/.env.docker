APP_NAME="Escalated Demo"
APP_ENV=demo
APP_KEY=base64:Zmh1YXNkaHVpaGFzZGl1aGZhc2Rpb2hmYXNkdWlzZDE=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=escalated
DB_USERNAME=escalated
DB_PASSWORD=escalated

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Showcase the newsletter system in the demo (off by default in the package).
# Must live here (not just compose `environment:`) so `php artisan serve`
# forwards it to its php -S worker — OS-only env vars are not passed through.
ESCALATED_ENABLE_NEWSLETTERS=true

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=demo@escalated.test
MAIL_FROM_NAME="Escalated Demo"
